# ── 조회수 (Upstash Redis) ────────────────────────────────
# https://console.upstash.com → Redis DB 생성 → REST 탭
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── 뉴스레터/문의 (Resend) ────────────────────────────────
# https://resend.com/api-keys, https://resend.com/audiences
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# 환영 메일 발신자 — Resend에서 도메인 인증 후 설정 (예: "빈플로우 <hello@binflow.dev>")
# 비워두면 환영 메일만 스킵되고 구독(Audience 적재)은 정상 동작
RESEND_FROM=
# 리드마그넷 링크 — 비워두면 블로그 치트시트 글로 기본 설정
LEAD_MAGNET_URL=
# star-gate 스위치(CAP-4) — GitHub repo URL을 넣으면 환영 메일에 스타 유도 노출, 지우고 재배포하면 off
STAR_GATE_URL=
# 진단 콜 신청을 받을 주소 — 게시물 하단 CTA의 mailto 수신자. 비워두면 CTA가 숨겨진다.
# ⚠️ 값을 여기나 코드에 적지 말 것(공개 저장소). Vercel 환경변수에만 넣는다.
# ⚠️ 받을 편지함이 있는 주소여야 한다 — inpilot.dev는 MX 레코드가 없어 hello@inpilot.dev로는 답장을 못 받는다.
# 이 값이 비면 12/06 판정의 인바운드 지표가 0에 고정된다(빌드 로그에 경고가 찍힌다).
CONTACT_EMAIL=

# ── 댓글 (giscus) — 클라이언트 노출값 (NEXT_PUBLIC_) ────────
# https://giscus.app 에서 저장소 설정 후 생성된 값 복사
NEXT_PUBLIC_GISCUS_REPO=          # 예: <owner>/<repo>
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# ⚠️ 모든 키는 선택사항입니다. 비워두면 해당 기능만 숨겨지고 사이트는 정상 동작합니다.
